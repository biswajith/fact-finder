# Copy to .env and fill in. Real environment variables win over this file.

# OpenAI key used by `fact-extractor extract`.
OPENAI_API_KEY=sk-replace-me

# Model ID for the extraction calls (spec: GPT-6 Luna).
FACT_EXTRACTOR_MODEL=gpt-6-luna

# Chat workspace planning (WEB_UI_SPEC.md 7.1): plan (default: every message gets a plan that lists its changes),
# or an older mode: auto | direct | light | heavy. And when a plan waits for the customer's yes:
# risky (default) | always | never with plan; on | heavy | off with the older modes.
# FACT_EXTRACTOR_CHAT_PLANNING=plan
# FACT_EXTRACTOR_CHAT_PLAN_APPROVAL=risky

# Reasoning effort of the chat's final-reply step after tool lookups (low|medium|high; off disables it).
# FACT_EXTRACTOR_CHAT_COMPOSE_EFFORT=low

# Optional: a proxy or compatible endpoint instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: LangSmith tracing of every LangChain call made by goldset.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true

# Turn off DeepEval's anonymous usage telemetry.
DEEPEVAL_TELEMETRY_OPT_OUT=1
